<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.alp.Alp</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- No mach-lookup exceptions: the notification-only updater runs entirely
	     in-process (URLSession + CryptoKit) and never launches a privileged
	     installer, so Sparkle's InstallerLauncher/Downloader services are gone. -->
</dict>
</plist>
