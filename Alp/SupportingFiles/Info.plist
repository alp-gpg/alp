<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Alp</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025-2026. All rights reserved.</string>
    <key>NSExtensionUsageDescription</key>
    <string>Alp uses a Mail extension to sign, encrypt, decrypt, and verify email messages with GPG.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <key>SUFeedURL</key>
    <string>https://alp-gpg.github.io/alp/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>x1JEeu9YAmQj4qXAdlxw0Y9KiizUVwJQzUcAVmajMuQ=</string>
    <!--
        Default off so a fresh install does not phone home for update checks
        without user consent — Alp is a privacy-focused tool. Users opt in
        via the "Updates" section in General settings. We strongly recommend
        flipping this on so security fixes (cert-pin rotations, helper
        bugfixes) reach users quickly.
    -->
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Decrypt with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>decryptSelection</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
            <key>NSReturnTypes</key>
            <array>
                <string>NSStringPboardType</string>
