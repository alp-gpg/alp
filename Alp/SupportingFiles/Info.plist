<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Alp</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025-2026. All rights reserved.</string>
    <key>NSExtensionUsageDescription</key>
    <string>Alp uses a Mail extension to sign, encrypt, decrypt, and verify email messages with GPG.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <key>ALPTeamID</key>
    <string>$(ALP_TEAM_ID)</string>
    <key>ALPBundlePrefix</key>
    <string>$(ALP_BUNDLE_PREFIX)</string>
</dict>
</plist>
