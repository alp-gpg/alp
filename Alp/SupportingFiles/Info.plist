            <dict>
                <key>default</key>
                <string>Decrypt File with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>decryptFile</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
