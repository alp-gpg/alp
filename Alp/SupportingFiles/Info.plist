<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Alp</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025-2026. All rights reserved.</string>
    <key>NSExtensionUsageDescription</key>
    <string>Alp uses a Mail extension to sign, encrypt, decrypt, and verify email messages with GPG.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <!--
        Notification-only updater config (replaced Sparkle). AlpUpdateFeedURL
        serves a signed release.json; AlpUpdatePublicKey is the base64 Ed25519
        public key (32 raw bytes) used by UpdateChecker to verify the manifest
        signature with CryptoKit. Auto-checks are opt-in via Settings → Updates
        (AlpAutomaticUpdateChecks); a fresh install never phones home for
        updates without consent.
    -->
    <key>AlpUpdateFeedURL</key>
    <string>https://alp-gpg.github.io/alp/release.json</string>
    <key>AlpUpdatePublicKey</key>
    <string>x1JEeu9YAmQj4qXAdlxw0Y9KiizUVwJQzUcAVmajMuQ=</string>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Decrypt with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>decryptSelection</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
            <key>NSReturnTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Verify with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>verifySelection</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Sign with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>signSelection</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
            <key>NSReturnTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Decrypt File with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>decryptFile</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Verify File with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>verifyFile</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Sign File with Alp</string>
            </dict>
            <key>NSMessage</key>
            <string>signFile</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Encrypt File with Alp…</string>
            </dict>
            <key>NSMessage</key>
            <string>encryptFile</string>
            <key>NSPortName</key>
            <string>Alp</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
